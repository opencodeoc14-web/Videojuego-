/* Chaos Twins — Isla del núcleo, v3. Vanilla Canvas 2D, no remote assets.
 * Simulation uses a fixed 120 Hz step. Distances are logical world pixels.
 * Append ?test=1 only for the included automated mechanics tests.
 */
(() => {
'use strict';
const $ = id => document.getElementById(id);
const canvas = $('game'), ctx = canvas.getContext('2d', {alpha:false});
if (!ctx) { $('titleScreen').innerHTML='<p>Este navegador no permite dibujar el juego. Prueba en otro navegador con Canvas 2D.</p>'; return; }
const stage = $('stage');
const TAU=Math.PI*2, WORLD=13200, FLOOR=470, GRAVITY=1900, FIXED=1/120;
const SAVE_KEY='chaos-twins-v2-save', RECORD_KEY='chaos-twins-v2-record', SETTINGS_KEY='chaos-twins-v2-settings';
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), lerp=(a,b,t)=>a+(b-a)*t;
const hit=(a,b)=>a.x<b.x+b.w && a.x+a.w>b.x && a.y<b.y+b.h && a.y+a.h>b.y;
const distance=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
const readStore=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key)) ?? fallback;}catch{return fallback;}};
let storageOK=true;
function store(key,value){try{localStorage.setItem(key,JSON.stringify(value));}catch{storageOK=false;}}
function removeStore(key){try{localStorage.removeItem(key);}catch{storageOK=false;}}
let settings=readStore(SETTINGS_KEY,{sound:true});
if(!settings || typeof settings!=='object') settings={sound:true};
let soundOn=settings.sound!==false;
let audio=null, audioGain=null;
function wakeAudio(){
  if(!soundOn)return;
  try {if(!audio){const Audio=window.AudioContext||window.webkitAudioContext;if(!Audio)return;audio=new Audio();audioGain=audio.createGain();audioGain.gain.value=.11;audioGain.connect(audio.destination);}if(audio.state==='suspended')audio.resume().catch(()=>{});}catch{/* Sound is optional. */}
}
function tone(freq=440,duration=.1,type='sine',endFreq=null,delay=0,volume=1){
  if(!soundOn||!audio||audio.state!=='running')return;
  const at=audio.currentTime+delay, osc=audio.createOscillator(),gain=audio.createGain();
  osc.type=type;osc.frequency.setValueAtTime(freq,at);if(endFreq)osc.frequency.exponentialRampToValueAtTime(endFreq,at+duration);
  gain.gain.setValueAtTime(.0001,at);gain.gain.exponentialRampToValueAtTime(Math.max(.0001,volume),at+.008);gain.gain.exponentialRampToValueAtTime(.0001,at+duration);
  osc.connect(gain);gain.connect(audioGain);osc.start(at);osc.stop(at+duration+.02);
}
function sound(name){
  if(name==='jump')tone(280,.16,'triangle',610,0,.75);
  else if(name==='double'){tone(440,.13,'sine',820);tone(740,.13,'sine',1050,.05,.5);}
  else if(name==='gear'){[659,830,988,1319].forEach((n,i)=>tone(n,.18,'sine',null,i*.055,.65));}
  else if(name==='spark')tone(1020,.08,'sine',1450,0,.25);
  else if(name==='spin')tone(210,.18,'sawtooth',65,0,.19);
  else if(name==='throw')tone(390,.22,'triangle',1100,0,.6);
  else if(name==='hit'){tone(140,.15,'sawtooth',48,0,.45);tone(66,.16,'triangle',38,0,.5);}
  else if(name==='break'){tone(220,.10,'square',55,0,.3);tone(750,.07,'sine',1400,.025,.25);}
  else if(name==='checkpoint'||name==='relay'){[440,554,659,880].forEach((n,i)=>tone(n,.35,'triangle',null,i*.1,.5));}
  else if(name==='victory'){[523,659,784,1046,784,1046,1319].forEach((n,i)=>tone(n,.35,'triangle',null,i*.13,.55));}
  else if(name==='slam')tone(95,.3,'triangle',34,0,1);
}
function updateSoundUI(){const b=$('soundButton');b.classList.toggle('muted',!soundOn);b.setAttribute('aria-pressed',String(soundOn));b.setAttribute('aria-label',soundOn?'Silenciar sonido':'Activar sonido');b.title=soundOn?'Sonido activado':'Sonido desactivado';}
updateSoundUI();
let mode='title', previousMode='title', simulationTime=0, elapsed=0, deaths=0, boxesBroken=0, kills=0, sparksCount=0;
let camX=0, camY=0, camZoom=1, camFocus=null, viewW=1067, viewH=600, scale=1, dpr=1, last=performance.now(),acc=0,shake=0,toastLeft=0;
let relay=false, lastCheckpoint=0, progress=0, walkParticle=0, visualClock=0;
let nextAutosave=0;
let platforms=[],gears=[],enemies=[],crates=[],sparks=[],particles=[],waves=[],checkpoints=[];
let tutorials=new Set();
const groundSeeds=[
 {x:0,w:850},{x:1010,w:860},{x:2010,w:950},{x:3120,w:1040},{x:4320,w:2430},
 {x:6940,w:1080},{x:8180,w:1270},{x:9640,w:1100},{x:10970,w:2180}
];
const ledgeSeeds=[
 {x:340,y:365,w:170},{x:605,y:268,w:175},
 {x:1100,y:368,w:185},{x:1370,y:272,w:180},{x:1705,y:355,w:165},
 {x:2110,y:365,w:180},{x:2350,y:274,w:195},{x:2580,y:302,w:135},{x:2760,y:365,w:155},
 {x:3220,y:367,w:180},{x:3480,y:260,w:190},{x:3910,y:365,w:175},
 {x:4390,y:362,w:185},{x:4670,y:266,w:200},{x:5010,y:362,w:170},
 {x:7040,y:354,w:170},{x:7270,y:250,w:185},{x:7565,y:323,w:165},{x:7825,y:220,w:150},
 {x:8240,y:363,w:180},{x:8475,y:264,w:195},{x:8785,y:185,w:175},{x:9105,y:333,w:185},
 {x:9690,y:364,w:180},{x:9940,y:258,w:195},{x:10245,y:184,w:175},{x:10535,y:342,w:175},
 {x:11045,y:360,w:185},{x:11320,y:247,w:195},{x:11665,y:330,w:175},{x:12035,y:220,w:190},{x:12405,y:355,w:180}
];
const gearSeeds=[
 {x:695,y:225},{x:2445,y:230},{x:4770,y:222},{x:7360,y:205},{x:8870,y:142},{x:10330,y:142}
];
const enemySeeds=[
 {x:1200,min:1060,max:1340},{x:1690,min:1590,max:1810},{x:2180,min:2100,max:2330},{x:2830,min:2750,max:2890},{x:3380,min:3210,max:3710},{x:4520,min:4380,max:4630},{x:5140,min:4930,max:5410},
 {x:7140,min:7000,max:7440},{x:7720,min:7520,max:7970},{x:8330,min:8200,max:8670},{x:9180,min:8950,max:9400},
 {x:9780,min:9670,max:10120},{x:10460,min:10230,max:10690},{x:11200,min:11020,max:11500},{x:11870,min:11660,max:12210},{x:12520,min:12360,max:12820}
];
const crateSeeds=[
 {x:415,y:421},{x:460,y:421},{x:505,y:421},{x:1135,y:320},{x:1530,y:421},{x:2210,y:317},{x:2700,y:421,heal:true},{x:3350,y:421},{x:3400,y:421},{x:3980,y:317},{x:4480,y:314},{x:4950,y:421,heal:true},{x:5420,y:421},
 {x:7060,y:421},{x:7110,y:421},{x:7315,y:202},{x:7640,y:421,heal:true},{x:8290,y:421},{x:8530,y:216},{x:9020,y:421},
 {x:9725,y:421},{x:10010,y:210},{x:10400,y:421,heal:true},{x:11110,y:421},{x:11390,y:199},{x:11730,y:421},{x:12100,y:172},{x:12620,y:421,heal:true}
];
const relayOrb={x:2648,y:250,r:23};
const gate={x:12900,y:305,w:102,h:165};
const player={x:115,y:422,w:34,h:48,vx:0,vy:0,facing:1,grounded:false,coyote:0,jumps:0,jumpBuffer:0,spin:0,spinCooldown:0,invincible:0,hp:3,runPhase:0,spawnX:115,spawnY:422};
const buddy={x:62,y:428,phase:0,mode:'follow',vx:0,vy:0,flight:0,cooldown:0,trail:0};
const boss={x:6000,y:382,w:94,h:88,hp:5,active:false,dead:false,phase:'idle',timer:1.25,hurt:0,flash:0};
const held=new Set(), touchHeld=new Set();
let saved=readStore(SAVE_KEY,null);
function validSave(s){return !!(s && s.version===2 && Number.isFinite(s.spawnX) && s.spawnX>=0 && s.spawnX<WORLD && Array.isArray(s.gears)&&Array.isArray(s.crates)&&Array.isArray(s.enemies));}
function refreshContinue(){saved=readStore(SAVE_KEY,null);$('continueButton').hidden=!validSave(saved);}
refreshContinue();
function resetWorld(){
 platforms=groundSeeds.map(p=>({...p,y:FLOOR,h:350,solid:true})).concat(ledgeSeeds.map(p=>({...p,h:27,solid:false})));
 gears=gearSeeds.map((g,i)=>({...g,id:i,taken:false}));enemies=enemySeeds.map((e,i)=>({...e,id:i,y:FLOOR-36,w:38,h:36,speed:56+i%3*13,dir:i%2?-1:1,alive:true,phase:i*1.8}));
 crates=crateSeeds.map((c,i)=>({...c,id:i,w:42,h:48,broken:false}));
 checkpoints=[{x:2060,y:FLOOR,active:false},{x:4980,y:FLOOR,active:false},{x:8350,y:FLOOR,active:false},{x:11180,y:FLOOR,active:false}];
 sparks=[];particles=[];waves=[];relay=false;lastCheckpoint=0;elapsed=0;deaths=0;kills=0;boxesBroken=0;sparksCount=0;simulationTime=0;walkParticle=0;nextAutosave=0;progress=0;camX=0;camY=0;camZoom=1;camFocus=null;shake=0;tutorials=new Set();
 Object.assign(player,{x:115,y:422,vx:0,vy:0,facing:1,grounded:false,coyote:0,jumps:0,jumpBuffer:0,spin:0,spinCooldown:0,invincible:0,hp:3,runPhase:0,spawnX:115,spawnY:422});
 Object.assign(buddy,{x:62,y:428,phase:0,mode:'follow',vx:0,vy:0,flight:0,cooldown:0,trail:0});
 Object.assign(boss,{x:6000,y:382,hp:5,active:false,dead:false,phase:'idle',timer:1.25,hurt:0,flash:0});
 clearInput();updateHUD(true);
}
function saveProgress(){
 if(mode!=='playing'&&mode!=='paused')return;
 store(SAVE_KEY,{version:2,spawnX:player.spawnX,spawnY:player.spawnY,checkpoint:lastCheckpoint,gears:gears.filter(g=>g.taken).map(g=>g.id),crates:crates.filter(c=>c.broken).map(c=>c.id),enemies:enemies.filter(e=>!e.alive).map(e=>e.id),relay,bossDead:boss.dead,elapsed,deaths,sparks:sparksCount,boxes:boxesBroken,kills});
 if(!storageOK)$('saveState').textContent='Guardado no disponible · Puedes seguir jugando';
}
function restoreProgress(s){
 if(!validSave(s))return;
 player.spawnX=s.spawnX;player.spawnY=Number.isFinite(s.spawnY)?clamp(s.spawnY,-100,FLOOR-player.h):422;player.x=player.spawnX;player.y=player.spawnY;buddy.x=player.x-48;buddy.y=player.y;
 lastCheckpoint=clamp(Number(s.checkpoint)||0,0,4);checkpoints.forEach((c,i)=>c.active=i<lastCheckpoint);
 gears.forEach(g=>g.taken=s.gears.includes(g.id));crates.forEach(c=>c.broken=s.crates.includes(c.id));enemies.forEach(e=>e.alive=!s.enemies.includes(e.id));
 relay=!!s.relay;if(relay)addBridge();boss.dead=!!s.bossDead;if(boss.dead)boss.hp=0;
 elapsed=Math.max(0,Number(s.elapsed)||0);deaths=Math.max(0,Number(s.deaths)||0);sparksCount=Math.max(0,Number(s.sparks)||0);boxesBroken=Math.max(0,Number(s.boxes)||0);kills=Math.max(0,Number(s.kills)||0);
 camX=clamp(player.x-viewW*.32,0,Math.max(0,WORLD-viewW));camY=0;camZoom=1;camFocus=null;
}
function startGame(continuing=false){
 const s=continuing?readStore(SAVE_KEY,null):null;
 resetWorld();if(s)restoreProgress(s);else removeStore(SAVE_KEY);
 mode='playing';$('titleScreen').hidden=true;$('modal').hidden=true;$('hud').hidden=false;$('objective').hidden=false;
 wakeAudio();canvas.focus({preventScroll:true});toast(continuing?'¡De vuelta! Tu equipo conserva los engranajes.':'La isla es mucho más grande. Explora arriba, abajo y más allá del centinela.','✦',4);updateHUD(true);saveProgress();
}
function toast(text,icon='✦',seconds=3){$('toastText').textContent=text;$('toastIcon').textContent=icon;$('toast').classList.add('show');toastLeft=seconds;}
